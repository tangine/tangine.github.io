{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u9996\u9875","text":"<pre><code>pip install mkdocs mkdocs-material mdx_truly_sane_lists\n</code></pre>"},{"location":"career/css/","title":"CSS 1","text":""},{"location":"career/javascript/","title":"JavaScript","text":""},{"location":"career/javascript/#varletconst","title":"<code>var</code>,<code>let</code>,<code>const</code>\u7684\u533a\u522b","text":"<ol> <li><code>var</code>\u80fd\u91cd\u590d\u58f0\u660e</li> <li><code>var</code>\u5b58\u5728\u53d8\u91cf\u63d0\u5347\uff08\u58f0\u660e\u4f1a\u63d0\u5347\u5230\u4f5c\u7528\u57df\u6700\u524d\u9762\uff09, <code>let</code>, <code>const</code>\u5b58\u5728\u6682\u65f6\u6027\u6b7b\u533a\uff08\u672a\u58f0\u660e\u524d\u4e0d\u80fd\u4f7f\u7528\uff09 </li> <li><code>var</code>\u6700\u5c0f\u4f5c\u7528\u57df\u4e3a\u51fd\u6570\u4f5c\u7528\u57df, <code>let</code>, <code>const</code>\u6709\u5757\u4f5c\u7528\u57df </li> <li><code>const</code>\u58f0\u660e\u7684\u53d8\u91cf\u4e0d\u80fd\u518d\u6b21\u8d4b\u503c</li> </ol>"},{"location":"career/javascript/#null-undefined","title":"<code>null</code>, <code>undefined</code>\u7684\u533a\u522b","text":"<ol> <li><code>null</code>\u8868\u793a\u7a7a\u5bf9\u8c61 </li> <li><code>undefined</code>\u8868\u793a\u5df2\u7ecf\u58f0\u660e\u4f46\u662f\u672a\u8d4b\u503c\uff0c\u5bf9\u8c61\u4e2d\u4e0d\u5b58\u5728\u7684\u5c5e\u6027</li> </ol>"},{"location":"career/javascript/#_1","title":"\u6570\u636e\u7c7b\u578b","text":"<ol> <li><code>JavaScript</code>\u4e2d\u7684\u6570\u636e\u7c7b\u578b\u5206\u4e3a\u57fa\u672c\u7c7b\u578b\u548c\u5f15\u7528\u7c7b\u578b </li> <li>\u57fa\u672c\u6570\u636e\u7c7b\u578b: <code>String</code>, <code>Number</code>, <code>string</code>, <code>Boolean</code>, <code>Undefined</code>, <code>Symbol</code>, <code>BigInt</code>, <code>Null</code> </li> <li>\u5f15\u7528\u6570\u636e\u7c7b\u578b: <code>Object</code>, <code>Array</code>, <code>Function</code>\u7b49</li> </ol>"},{"location":"career/javascript/#_2","title":"\u5982\u4f55\u5224\u65ad\u6570\u636e\u7c7b\u578b","text":"<ol> <li><code>typeof</code> \u662f\u5426\u7528\u4e8e\u5224\u65ad\u9664<code>Null</code>\u5916\u7684\u57fa\u672c\u7c7b\u578b\u548c\u51fd\u6570 </li> <li><code>instanceof</code> \u7528\u4e8e\u68c0\u6d4b\u5bf9\u8c61\u662f\u5426\u662f\u67d0\u6784\u9020\u51fd\u6570\u7684\u5b9e\u4f8b\uff08\u68c0\u67e5\u539f\u578b\u94fe\uff09 </li> <li>\u901a\u8fc7\u5bf9\u8c61\u7684 constructor \u83b7\u53d6\u6784\u9020\u51fd\u6570 </li> <li><code>Object.prototype.toString.call()</code> \u901a\u7528\u4e14\u51c6\u786e</li> </ol>"},{"location":"career/javascript/#_3","title":"\u6df1\u62f7\u8d1d","text":"<ol> <li>\u57fa\u672c\u7c7b\u578b\u8d4b\u503c\u5373\u6df1\u62f7\u8d1d\uff0c\u6df1\u62f7\u8d1d\u53ea\u9002\u7528\u4e8e\u5f15\u7528\u7c7b\u578b </li> <li>\u6269\u5c55\u8fd0\u7b97\u7b26 ... \u6d45\u62f7\u8d1d </li> <li><code>Object.assign()</code>\u6d45\u62f7\u8d1d </li> <li><code>JSON.parse(JSON.stringify())</code>\u7f3a\u70b9\uff1a\u65e0\u6cd5\u5904\u7406<code>Null</code>, <code>Undefined</code>,<code>Symbol</code>, \u65e5\u671f\uff0c\u51fd\u6570\u7b49\uff0c\u65e0\u6cd5\u5904\u7406\u5faa\u73af\u5f15\u7528\uff0c\u4f1a\u4e22\u5931\u539f\u578b\u94fe\u4fe1\u606f </li> <li><code>structuredClone()</code> \u65e0\u6cd5\u62f7\u8d1d\u51fd\u6570 </li> <li><code>loadsh</code> \u7b49\u4e09\u65b9\u5e93</li> <li>\u901a\u8fc7\u9012\u5f52\u81ea\u5df1\u5b9e\u73b0</li> </ol>"},{"location":"career/javascript/#this","title":"<code>this</code>\u6307\u5411","text":"<ol> <li>\u4f5c\u4e3a\u5bf9\u8c61\u65b9\u6cd5\u8c03\u7528\u65f6\uff0c\u6307\u5411\u8c03\u7528\u5bf9\u8c61</li> <li>\u4f5c\u4e3a\u6784\u9020\u51fd\u6570\u4f7f\u7528\uff0c\u6307\u5411\u65b0\u521b\u5efa\u7684\u5bf9\u8c61\u5b9e\u4f8b </li> <li>\u4f5c\u4e3a\u666e\u901a\u51fd\u6570\u72ec\u7acb\u8c03\u7528\u65f6\uff0c\u975e\u4e25\u683c\u6a21\u5f0f\u6307\u5411<code>window</code>\uff0c\u4e25\u683c\u6a21\u5f0f\u4e3a<code>undefined</code> </li> <li><code>call</code>, <code>apply</code>, <code>bind</code> \u4e3a\u663e\u793a\u7ed1\u5b9a\uff0c\u5f53\u6307\u5b9a\u5bf9\u8c61\u4e0d\u662f<code>undefined</code>, <code>null</code> \u65f6\uff0c\u4e3a\u6307\u5b9a\u5bf9\u8c61\uff0c\u5426\u5219\u4e3a<code>window</code> </li> <li>\u7bad\u5934\u51fd\u6570\u4e2d\u7684 this \u7ee7\u627f\u81ea\u5916\u5c42\u4f5c\u7528\u57df(\u8ddf\u5b9a\u4e49\u4f4d\u7f6e\u6709\u5173\uff0c\u8ddf\u8c03\u7528\u4f4d\u7f6e\u65e0\u5173)</li> </ol>"},{"location":"career/javascript/#_4","title":"\u95ed\u5305","text":""},{"location":"career/javascript/#_5","title":"\u9632\u6296\u548c\u8282\u6d41","text":"<ol> <li>\u9632\u6296\uff1a\u5728\u4e8b\u4ef6\u89e6\u53d1\u540e\uff0c\u7b49\u5f85\u4e00\u6bb5\u65f6\u95f4\u518d\u6267\u884c\u56de\u8c03\u3002 </li> <li>\u8282\u6d41\uff1a\u5728\u4e00\u5b9a\u65f6\u95f4\u5185\u53ea\u6267\u884c\u4e00\u6b21\u56de\u8c03\u3002 <pre><code>// \u9632\u6296\nfunction debounce(func, wait) {\n    let timeout;\n    return function(...args) {\n        clearTimeout(timeout);\n        timeout = setTimeout(() =&gt; func.apply(this, args), wait);\n    };\n}\n\n// \u8282\u6d41\nfunction throttle(func, wait) {\n    let lastTime = 0;\n    return function(...args) {\n        const now = Date.now();\n        if (now - lastTime &gt;= wait) {\n            func.apply(this, args);\n            lastTime = now;\n        }\n    };\n}\n</code></pre></li> </ol>"},{"location":"career/vue/","title":"Vue","text":""},{"location":"career/vue/#vue","title":"VUE\u6d4b\u8bd5","text":""},{"location":"finance/kline/","title":"\u65e5\u672c\u8721\u70db\u56fe\u6280\u672f","text":""},{"location":"finance/kline/#_1","title":"\u65e5\u672c\u8721\u70db\u56fe\u6280\u672f","text":"<pre><code># \u722c\u53d6\u540c\u82b1\u987a\u5386\u53f2\u6570\u636e\nurl = \"https://localhost:5432/test\"\ndef crawl_hist_by_ths():\n    pass\n</code></pre>"},{"location":"finance/stock/","title":"\u80a1\u5e02\u98ce\u4e91","text":""},{"location":"finance/stock/#_2","title":"\u80a1\u7968\u6570\u636e\u722c\u53d6","text":"<pre><code># \u722c\u53d6\u540c\u82b1\u987a\u5386\u53f2\u6570\u636e\nurl = \"https://localhost:5432/test\"\ndef crawl_hist_by_ths():\n    pass\n</code></pre>"},{"location":"finance/technical/","title":"\u91d1\u878d\u5e02\u573a\u6280\u672f\u5206\u6790","text":""},{"location":"finance/technical/#_1","title":"\u91d1\u878d\u5e02\u573a\u6280\u672f\u5206\u6790","text":"<pre><code># \u722c\u53d6\u540c\u82b1\u987a\u5386\u53f2\u6570\u636e\nurl = \"https://localhost:5432/test\"\ndef crawl_hist_by_ths():\n    pass\n</code></pre>"},{"location":"finance/volume/","title":"\u91cf\u4ef7\u5206\u6790","text":""},{"location":"finance/volume/#_1","title":"\u4ea4\u6613\u4e4b\u4e2d\u65e0\u65b0\u4e8b","text":""},{"location":"finance/volume/#_2","title":"\u4e3a\u4f55\u6210\u4ea4\u91cf\u5982\u6b64\u91cd\u8981","text":""},{"location":"finance/volume/#_3","title":"\u5408\u7406\u7684\u4ef7\u683c","text":""},{"location":"finance/volume/#_4","title":"\u91cf\u4ef7\u5206\u6790\u7684\u9996\u8981\u539f\u5219","text":""},{"location":"finance/volume/#_5","title":"\u91cf\u4ef7\u5206\u6790\u7684\u5168\u5c40\u89c6\u89d2","text":""},{"location":"finance/volume/#k","title":"\u7ed3\u5408K\u7ebf\u56fe\u7684\u91cf\u4ef7\u5206\u6790","text":""},{"location":"finance/volume/#_6","title":"\u57fa\u672c\u539f\u5219","text":"<p>\u7b2c\u4e00\u539f\u5219\uff1a \u5f71\u7ebf\u7684\u957f\u5ea6\uff0c\u65e0\u8bba\u662f\u4e0a\u5f71\u7ebf\u8fd8\u662f\u4e0b\u5f71\u7ebf\u90fd\u4e00\u76f4\u662f\u6211\u4eec\u5173\u6ce8\u7684\u9996\u8981\u56e0\u7d20\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u4ee5\u7acb\u523b\u663e\u793a\u540e\u7eed\u5e02\u573a\u7684\u5f3a\u52bf\u3001\u5f31\u52bf\u4ee5\u53ca\u8fdf\u7591\uff0c\u66f4\u91cd\u8981\u7684\u662f\u80fd\u663e\u793a\u5e02\u573a\u7684\u60c5\u7eea\u3002</p> <p>\u7b2c\u4e8c\u539f\u5219\uff1a \u5982\u679c\u6ca1\u6709\u5f62\u6210\u5f71\u7ebf\uff0c\u90a3\u4e48\u8fd